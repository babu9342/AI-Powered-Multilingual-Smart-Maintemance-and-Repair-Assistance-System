# FixLink Environment Variables
# Copy this file to .env and fill in your real API keys

# ── LLM API Keys (Fixed order: OpenAI -> DeepSeek -> Gemini) ───
GEMINI_API_KEY=gemini api key
OPENAI_API_KEY=chatgpt api key
DEEPSEEK_API_KEY=deepseek

# ── LLM Model Names (override if needed) ───────────────────

OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_MODEL=deepseek-chat
GEMINI_MODEL=gemini-1.5-flash

# ── Cooldown after quota exhaustion (in minutes) ───────────

OPENAI_COOLDOWN_MIN=60
DEEPSEEK_COOLDOWN_MIN=60
GEMINI_COOLDOWN_MIN=15

# ── Database ────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
DB_NAME=fixlink_db

# ── Auth ────────────────────────────────────────────────────
JWT_SECRET=fixlink_super_secret_jwt_key_2026_production

# ── Rate Limiting ───────────────────────────────────────────
CHAT_RATE_LIMIT_PER_MINUTE=15
